# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API). Only use the publishable key here, never the secret key:
# anything starting with VITE_ is built into the website and visible to visitors.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...
